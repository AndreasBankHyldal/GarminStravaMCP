# Strava OAuth credentials (get from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Garmin Connect credentials
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Database path (optional, defaults to ./data/training.db)
DB_PATH=./data/training.db
