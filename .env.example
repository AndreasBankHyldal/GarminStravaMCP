# On Windows, copy this file to:
# %LOCALAPPDATA%\GarminMCP\.env
#
# On macOS/Linux, the default location remains ./.env.

# Garmin Connect credentials
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Master opt-in for all women-specific tools, prompts, and guidance.
# Leave false for the default MCP tool set.
I_AM_WOMAN=false

# Explicit opt-in for highly sensitive reproductive-health reads through Garmin's
# unofficial consumer API. Requires I_AM_WOMAN=true as well.
GARMIN_WOMENS_HEALTH_ENABLED=false

# Database path (optional). Relative paths resolve from the state directory.
DB_PATH=./data/training.db

# --- Hosted HTTP mode (see docs/hosting-oracle.md) -------------------------
# stdio stays the default. `npm run start:http` or MCP_TRANSPORT=http serves
# Streamable HTTP on /mcp with bearer-token auth and an unauthenticated /healthz.
# MCP_TRANSPORT=http
# Required in HTTP mode, at least 32 characters: openssl rand -hex 32
# MCP_AUTH_TOKEN=
# Interface and port. Keep 127.0.0.1 outside Docker; docker-compose sets 0.0.0.0.
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# Public hostname(s) accepted in Host/Origin besides localhost, comma-separated.
# MCP_ALLOWED_HOSTS=
# docker-compose + Caddy: the DuckDNS hostname that gets the HTTPS certificate.
# MCP_PUBLIC_HOST=your-name.duckdns.org
# docker-compose: run the app as the host user owning ./state (`id -u` / `id -g`).
# APP_UID=1000
# APP_GID=1000
# Use X-Forwarded-For for failed-auth rate limiting (only behind a trusted proxy).
# MCP_TRUST_PROXY=false
# Women's-health tools stay off over HTTP unless this is also true.
# MCP_HTTP_ALLOW_WOMEN_TOOLS=false
