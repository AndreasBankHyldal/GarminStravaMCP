# On Windows, copy this file to:
# %LOCALAPPDATA%\GarminMCP\.env
#
# On macOS/Linux, the default location remains ./.env.

# Garmin Connect credentials
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Master opt-in for all women-specific tools, prompts, and guidance.
# Leave false for the default MCP tool set.
I_AM_WOMAN=false

# Explicit opt-in for highly sensitive reproductive-health reads through Garmin's
# unofficial consumer API. Requires I_AM_WOMAN=true as well.
GARMIN_WOMENS_HEALTH_ENABLED=false

# Database path (optional). Relative paths resolve from the state directory.
DB_PATH=./data/training.db
