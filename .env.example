# On Windows, copy this file to:
# %LOCALAPPDATA%\GarminStravaMCP\.env
#
# On macOS/Linux, the default location remains ./.env.

# Strava OAuth credentials (get from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Garmin Connect credentials
GARMIN_USERNAME=
GARMIN_PASSWORD=

# Database path (optional). Relative paths resolve from the state directory.
DB_PATH=./data/training.db
